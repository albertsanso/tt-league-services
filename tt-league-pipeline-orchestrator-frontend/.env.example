# Dev proxy target for /api/pipeline (orchestrator runtime).
VITE_API_PROXY_TARGET=http://localhost:8095
# Dev proxy target for /api/v1 (platform REST API, login).
VITE_PLATFORM_PROXY_TARGET=http://localhost:8080
# Optional absolute base URL of the orchestrator when it is not served on the SPA origin. Empty = same origin.
VITE_ORCHESTRATOR_BASE_URL=
# Optional absolute base URL of the platform API when it is not served on the SPA origin. Empty = same origin.
VITE_PLATFORM_BASE_URL=
