# Local IDE run configuration (.run/*.run.xml); paste its lines into each run configuration. Copy to .env.local, which Git ignores.
# Plain KEY=value lines, no quotes. Never commit .env.local.

# PostgreSQL 16, database ttleaguedata. Native install: localhost:5432. Only the Podman database: localhost:15432.
DB_TTLEAGUEDATA_JDBC_URL=jdbc:postgresql://localhost:5432/ttleaguedata
DB_TTLEAGUEDATA_CREDENTIAL_USERNAME=CHANGE_ME_db_user
DB_TTLEAGUEDATA_CREDENTIAL_PASSWORD=CHANGE_ME_db_password
PIPELINE_DB_URL=jdbc:postgresql://localhost:5432/ttleaguedata
PIPELINE_DB_USERNAME=CHANGE_ME_db_user
PIPELINE_DB_PASSWORD=CHANGE_ME_db_password
# Shared by the platform and the orchestrator (at least 32 bytes): openssl rand -base64 32
JWT_SIGNING_SECRET=CHANGE_ME_generated_secret
# Orchestrator -> platform service credential. The platform only stores the key's SHA-256:
#   printf %s "<key>" | openssl dgst -sha256 -hex
PIPELINE_PLATFORM_URL=http://localhost:8080
PIPELINE_PLATFORM_API_KEY=CHANGE_ME_generated_key
SECURITY_SERVICECREDENTIALS_0_NAME=orchestrator
SECURITY_SERVICECREDENTIALS_0_KEYSHA256=CHANGE_ME_sha256_of_PIPELINE_PLATFORM_API_KEY
SECURITY_SERVICECREDENTIALS_0_PERMISSIONS=imports:write,matches:read

# Orchestrator -> ingest (the ingest REST service reads the same key as TT_INGEST_REST_API_KEY)
PIPELINE_INGEST_URL=http://localhost:8091
PIPELINE_INGEST_API_KEY=CHANGE_ME_generated_key
TT_INGEST_REST_API_KEY=CHANGE_ME_same_value_as_PIPELINE_INGEST_API_KEY
# The ingest REST service listens on 8090 unless told otherwise; the orchestrator expects 8091.
TT_INGEST_REST_PORT=8091
# Existing directory
TT_INGEST_DATA_DIR=C:/tmp/tt-ingest-data
PIPELINE_ARTIFACTS_DIR=C:/tmp/pipeline-artifacts
