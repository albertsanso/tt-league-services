# Environment template for deploy/compose.yaml (FEAT-00116).
# Copy it to deploy/.env, replace every <placeholder>, and never commit deploy/.env.
# Required values have no default: `docker compose config` and `up` fail with the variable's name when one is missing.

# ---- Required -------------------------------------------------------------------------------------------------

# PostgreSQL superuser, used by the platform. The database name is fixed: ttleaguedata.
POSTGRES_USER=ttleague
# openssl rand -base64 32
POSTGRES_PASSWORD=<generate>

# Password of the "pipeline" role, which owns only the orchestrator's schema (created on the first start only).
# openssl rand -base64 32
PIPELINE_DB_PASSWORD=<generate>

# Signs and validates the login tokens; the platform and the orchestrator share it. At least 32 bytes.
# openssl rand -base64 48
JWT_SIGNING_SECRET=<generate>

# The orchestrator's credential on the platform (FEAT-00101). The orchestrator gets the key, the platform only its hash.
#   ORCHESTRATOR_PLATFORM_API_KEY=$(openssl rand -base64 32)
#   printf '%s' "$ORCHESTRATOR_PLATFORM_API_KEY" | sha256sum | cut -d' ' -f1
ORCHESTRATOR_PLATFORM_API_KEY=<generate>
ORCHESTRATOR_PLATFORM_API_KEY_SHA256=<64 hex characters, the SHA-256 of the key above>

# Shared by the orchestrator and tt-league-ingest-rest (X-API-Key).
# openssl rand -base64 32
PIPELINE_INGEST_API_KEY=<generate>

# ---- Optional: addresses and images ---------------------------------------------------------------------------

# Public base URL of the platform UI, used in password-recovery e-mails.
PUBLIC_PLATFORM_URL=http://localhost:8080
# Host ports of the two UIs (the only published ports).
PROXY_PLATFORM_PORT=8080
PROXY_PIPELINE_PORT=8081
# Image tag, and the revision recorded in the image labels (for example: GIT_SHA=$(git rev-parse --short HEAD)).
IMAGE_TAG=local
GIT_SHA=unknown

# ---- Optional: platform mail (password recovery) --------------------------------------------------------------

PASSWORD_RECOVERY_FROM=no-reply@localhost
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Optional: orchestrator schedule, polling and notifications -----------------------------------------------
# Everything below is off while empty. See tt-league-pipeline-orchestrator-runtime/README.md.

# Season and cron (Spring six-field format, for example "0 0 7,22 * * *") of the fixed-schedule full-season runs.
PIPELINE_SCHEDULE_SEASON=
PIPELINE_SCHEDULE_ZONE=Europe/Madrid
PIPELINE_SCHEDULE_RFETM_CRON=
PIPELINE_SCHEDULE_BCNESA_CRON=
PIPELINE_SCHEDULE_FCTT_CRON=
# Comma-separated sources polled adaptively (a source cannot also have a cron).
PIPELINE_POLLING_SOURCES=
PIPELINE_STATISTICS_ZONE=Europe/Madrid
# E-mail alerts are enabled only when the host is set.
PIPELINE_MAIL_HOST=
PIPELINE_MAIL_PORT=587
PIPELINE_MAIL_USERNAME=
PIPELINE_MAIL_PASSWORD=
PIPELINE_MAIL_STARTTLS=true
PIPELINE_MAIL_FROM=
PIPELINE_MAIL_TO=
